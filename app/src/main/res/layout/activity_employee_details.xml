<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvEmployeeId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvDepartment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvDesignation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvJoiningDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvManager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnManageTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Tasks"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/btnManageDocuments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Documents"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnEditEmployee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Employee"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnInductionActivities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Induction Activities"
            android:layout_marginTop="8dp"/>


    </LinearLayout>

</ScrollView>